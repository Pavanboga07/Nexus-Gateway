# Nexus relay (v0.3) configuration.
# Copy to .env for local runs. NEVER commit real credentials.

# Database (REQUIRED — the relay refuses to boot without it).
# Async SQLAlchemy URL for the relay's Postgres.
RELAY_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5433/nexus_relay

# Networking (Render sets PORT; default 8000 locally).
PORT=8000

# Free-tier self-ping (OPT-IN, default OFF — leave unset to disable).
# Set BOTH to enable the lifespan keep-alive loop:
# RELAY_SELF_PING_URL=https://your-service.onrender.com
# RELAY_SELF_PING_INTERVAL=600
