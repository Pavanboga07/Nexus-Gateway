# Nexus relay (v0.3) configuration.
# Copy to .env for local runs. NEVER commit real credentials.

# Database (REQUIRED — the relay refuses to boot without it).
# Async SQLAlchemy URL for the relay's Postgres.
RELAY_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5433/nexus_relay

# Networking (Render sets PORT; default 9000 locally).
PORT=9000

# Logging verbosity (DEBUG, INFO, WARNING, ERROR).
RELAY_LOG_LEVEL=INFO

# WebSocket auth handshake timeout, seconds (slowloris guard).
RELAY_AUTH_TIMEOUT_SECONDS=10

# Max WebSocket message size, bytes (DoS guard; 64 KiB default).
RELAY_MAX_WS_MESSAGE_BYTES=65536

# Cap for POST /invites ttl_seconds (prevents immortal invites; 24h default).
RELAY_MAX_INVITE_TTL_SECONDS=86400

# Retention cleanup: how often the background sweeper runs, seconds.
RELAY_CLEANUP_INTERVAL_SECONDS=300

# Retention cleanup: delivered/expired messages older than this are purged, days.
RELAY_DELIVERED_RETENTION_DAYS=7

# /metrics bearer token. HIGHLY RECOMMENDED: when unset, /metrics is
# unauthenticated and the relay logs a warning at boot.
# RELAY_METRICS_TOKEN=change-me-to-something-long-and-random

# Free-tier self-ping (OPT-IN, default OFF — leave unset to disable).
# Set BOTH to enable the lifespan keep-alive loop:
# RELAY_SELF_PING_URL=https://your-service.onrender.com
# RELAY_SELF_PING_INTERVAL=600
