# Nexus Gateway Configuration
# All variables use the GATEWAY_ prefix to guarantee independence

# Networking
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000

# Database (Separate from Nexus database)
GATEWAY_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5433/nexus_gateway

# Authentication
GATEWAY_AUTH_TIMEOUT_SECONDS=10.0

# Message Limits
GATEWAY_MAX_MESSAGE_SIZE=65536
GATEWAY_MESSAGE_TTL_SECONDS=86400
GATEWAY_MAX_QUEUE_PER_AGENT=1000

# Connection Limits
GATEWAY_MAX_CONNECTIONS=500

# Heartbeat & Liveness
GATEWAY_HEARTBEAT_INTERVAL_SECONDS=30.0
GATEWAY_HEARTBEAT_TIMEOUT_SECONDS=90.0

# Maintenance
GATEWAY_QUEUE_CLEANUP_INTERVAL_SECONDS=300.0

# Logging
GATEWAY_LOG_LEVEL=INFO
